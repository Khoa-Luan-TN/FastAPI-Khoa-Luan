# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_NAME=data-edu

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=Metadata-Edu

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_BUCKET=data-edu

# ── Frontend ───────────────────────────────────────────────────────────────
# Browser-facing API base.
# Keep these as /api so the frontend and backend stay on one domain.
VITE_API_URL=/api
VITE_API_BASE_URL=/api
VITE_API_BASE=/api

# ── OIDC / SSO (same variable format as nguyenvantuan) ────────────────────
VITE_OIDC_ISSUER=https://api.etechs.vn
VITE_OIDC_CLIENT_ID=ers-fe
VITE_OIDC_REDIRECT_URI=https://ers.etechs.vn/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://ers.etechs.vn
VITE_OIDC_SCOPE="openid profile email"

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins for the FastAPI backend.
# Add your server domain/IP here when deploying to a remote server, e.g.:
#   CORS_ORIGINS=http://your-server-ip:3040,https://your-domain.com
CORS_ORIGINS=http://localhost:3040,https://ers.etechs.vn

# ── Embedding model ────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# ── Gemini API keys ────────────────────────────────────────────────────────
# Comma-separated list of Gemini API keys used for AI features and key rotation.
# Required for search (topic-probe) and alias generation.
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=AIzaSyBZbVs_2_e2OSUaBIXjVTVNCgpCA2Z92i0,AIzaSyB_4mkx5Lpnp0L0lIr9sQmLGAuee02BOeQ,AIzaSyCFSClPzsmtWFh5OKT4qRfDrQeTLfsG8QQ,AIzaSyBbvNG-rIfDHXXN1xvW_D2KaS4mC9ObAfQ,AIzaSyD9i4JhftTHXvMudi0UK_9IomccXbgk_7E,AIzaSyCHMq1UqoC0hIeRpih0uiFjOpcohgqarU0,AIzaSyAQD7ptngT8TaiV304xWY4cjGV8q0FwrR4,AIzaSyCOeD-j3cLt1WuxLpSKxbZmz-5xBTvmvsw,AIzaSyBW-v18fI_pUFPhsTAay8d0T_oEn8Sna1Q,AIzaSyDy7dkYZzQqTVOxyznengHJZ9BPty0zazg,AIzaSyDIjIouon7Lwu92v74I4hlHcRuhIOQXRHQ,AIzaSyAV9qPtuziSNuDn4O9PdtakkCayioh4dCQ,AIzaSyDjtvqHQkeU2Evv05jam1TbXRvn8CvkVkM,AIzaSyB_4mkx5Lpnp0L0lIr9sQmLGAuee02BOeQ,AIzaSyCFSClPzsmtWFh5OKT4qRfDrQeTLfsG8QQ,AIzaSyBbvNG-rIfDHXXN1xvW_D2KaS4mC9ObAfQ,AIzaSyD9i4JhftTHXvMudi0UK_9IomccXbgk_7E,AIzaSyCHMq1UqoC0hIeRpih0uiFjOpcohgqarU0,AIzaSyAQD7ptngT8TaiV304xWY4cjGV8q0FwrR4,AIzaSyCOeD-j3cLt1WuxLpSKxbZmz-5xBTvmvsw,AIzaSyBW-v18fI_pUFPhsTAay8d0T_oEn8Sna1Q,AIzaSyDy7dkYZzQqTVOxyznengHJZ9BPty0zazg,AIzaSyBZbVs_2_e2OSUaBIXjVTVNCgpCA2Z92i0,AIzaSyAwm8K8dgBrj4v_0qW5c-obERHRgE-qgf8, AIzaSyBqb1WrjHmiKEJT_HL8kUaiuE0vHhsSXKY, AIzaSyD2qysFgPm9ML_cQLbMrkP8G67CT1HyBa8, AIzaSyD_FUKV7VVVcx4eKSWDTRYcxEU3gaOaT4U, AIzaSyDIzSkycAyZ9izHR6PB3qdyA6TCs_h_t_Y, AIzaSyBWq2-NJhNSOpxbBDht_gfwayVhEXd9Kgk, AIzaSyCZGOm83Eua5pHUmXCDTbzccvoJ-TwaYck, AIzaSyDb9rhvFsnrqNLRG_TzTgU7Y4nQ5gnZuds, AIzaSyCMZe6cchb2VUCRn4CoMyYd_AGcwFl6ysA, AIzaSyBl33TqvzbUVhINmUowIutgzcQ0GXkoqkc, AIzaSyCYx7PNo1qc2hotG0lI8NIHOiynGl2pCtY, AIzaSyCynUIwLuUACDpULnEGrzBk8g7gB0ixVow, AIzaSyD7PkXVnUYxFe-eiOsGURNGAKMJiLFo9fs, AIzaSyAu-VBxj8EG7yc43NnTCzB95I21iDK44I0, AIzaSyCTQ_wKU4w2iryrIU6I3Er-gk3zzWPEKzo, AIzaSyBSWn6zRfX1pEPFBQsO5WJ2ZrJFfZGv0Us, AIzaSyDb97rRDZkn9ojHibWXs-FghaMQkgPuA4M, AIzaSyAQVPGIwsvegtlbGEWjzATzdzJxpo2nXY0,AIzaSyAv3ZKJywkf32ZKFMdOtB-JcJBlaSJxh8o,AIzaSyD36CjF3x1fX5S5m4Zo_nudW4BHtA-hcck,AIzaSyCECEfOTn5HDIZBNMlUAcfBNB8DvjzqnmU,AIzaSyClGrEVJyvunC6HoRaDWp1qcocY4msMrnU,AIzaSyDJ8Q8JKCIdXyCvrQnqzY3JQ3Jx2ACmlyw,AIzaSyBR1aWLdCFG1pQRlaSo4DWyVVWwP7JSC9g,AIzaSyDCWXpU9TGGatyKXLIpeadGJaCzPWcmj2w,AIzaSyBP0rMxm2gqO76UwOXDpMdMIxb_ftBSHy0,AIzaSyC