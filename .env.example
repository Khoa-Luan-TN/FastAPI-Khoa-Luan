# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_NAME=data-edu

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=Metadata-Edu

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_BUCKET=data-edu
MINIO_PUBLIC_BASE_URL=https://ers.etechs.vn/api/files
VITE_MINIO_PUBLIC_BASE_URL=https://ers.etechs.vn/api/files

# ── Frontend ───────────────────────────────────────────────────────────────
# Browser-facing API base.
# For the ers.etechs.vn deployment, keep these as /api so the frontend and
# backend stay on one domain and nginx forwards /api/* to FastAPI.
VITE_API_URL=/api
VITE_API_BASE_URL=/api
VITE_API_BASE=/api

# ── OIDC / SSO (same variable format as nguyenvantuan) ────────────────────
VITE_OIDC_ISSUER=https://api.etechs.vn
VITE_OIDC_CLIENT_ID=ers-fe
VITE_OIDC_REDIRECT_URI=https://ers.etechs.vn/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://ers.etechs.vn
VITE_OIDC_SCOPE="openid profile email"

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins for the FastAPI backend.
# Add your server domain/IP here when deploying to a remote server, e.g.:
#   CORS_ORIGINS=http://your-server-ip:3040,https://your-domain.com
CORS_ORIGINS=http://localhost:3040,https://ers.etechs.vn

# ── Embedding model ────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# ── Gemini API keys ────────────────────────────────────────────────────────
# Comma-separated list of Gemini API keys used for AI features and key rotation.
# Required for search (topic-probe) and alias generation.
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=your_key_1,your_key_2

# ── Feature flags ─────────────────────────────────────────────────────────
DISABLE_KEYWORD_ALIAS_AUTO=false
DISABLE_ALIAS_GENERATION=false

# ── Auto-restore ───────────────────────────────────────────────────────────
# Set AUTO_RESTORE=true to automatically restore databases on docker compose up.
# Restores PostgreSQL, MongoDB, and MinIO if backup files are present in database/.
# The auto-restore service uses the Docker socket (/var/run/docker.sock).
# Neo4j cannot be auto-restored (requires offline load) — see DEPLOY_SERVER.md.
AUTO_RESTORE=true

# Set NEO4J_AUTO_RESTORE=true to include Neo4j when running restore-all.sh manually.
# Has no effect inside the compose auto-restore service (always skipped there).
# Ensure the neo4j container is stopped before running: bash docker/restore-all.sh
NEO4J_AUTO_RESTORE=false

# ── Cloudflare Tunnel (optional profile: tunnel) ───────────────────────────
# Place the tunnel credentials JSON inside ./cloudflared and reference only
# the filename below, for example:
#   CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=12345678-1234-1234-1234-123456789abc.json
# Start with:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_HOSTNAME=ers.etechs.vn
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=
