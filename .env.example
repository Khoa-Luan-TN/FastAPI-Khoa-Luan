# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_NAME=data-edu

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=Metadata-Edu

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_BUCKET=data-edu

# ── Frontend ───────────────────────────────────────────────────────────────
# URL where the BROWSER reaches the backend (build-time variable — requires
# rebuilding the frontend image after changing: docker compose build frontend)
VITE_API_BASE=http://localhost:8000

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins for the FastAPI backend.
# Add your server domain/IP here when deploying to a remote server, e.g.:
#   CORS_ORIGINS=http://your-server-ip:3000,https://your-domain.com
CORS_ORIGINS=

# ── Embedding model ────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# ── Gemini API keys ────────────────────────────────────────────────────────
# Comma-separated list of Gemini API keys used for AI features and key rotation.
# Required for search (topic-probe) and alias generation.
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=your_key_1,your_key_2

# ── Feature flags ─────────────────────────────────────────────────────────
DISABLE_KEYWORD_ALIAS_AUTO=false
DISABLE_ALIAS_GENERATION=false

# ── Auto-restore ───────────────────────────────────────────────────────────
# Set AUTO_RESTORE=true to automatically restore databases on docker compose up.
# Restores PostgreSQL, MongoDB, and MinIO if backup files are present in database/.
# The auto-restore service uses the Docker socket (/var/run/docker.sock).
# Neo4j cannot be auto-restored (requires offline load) — see DEPLOY_SERVER.md.
AUTO_RESTORE=false

# Set NEO4J_AUTO_RESTORE=true to include Neo4j when running restore-all.sh manually.
# Has no effect inside the compose auto-restore service (always skipped there).
# Ensure the neo4j container is stopped before running: bash docker/restore-all.sh
NEO4J_AUTO_RESTORE=false
